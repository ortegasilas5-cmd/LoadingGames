@model LoadingGames.Models.AdminCatalogoViewModel
@{
    ViewData["Title"] = "Gerenciar " + Model.Titulo;
}
<div class="container mt-4">
    <h1>Gerenciar @Model.Titulo</h1>
    <div class="d-flex gap-2 flex-wrap my-3">
        <a asp-action="Index" asp-route-tipo="generos" class="btn @(Model.Tipo == "generos" ? "btn-primary" : "btn-outline-primary")">Gêneros</a>
        <a asp-action="Index" asp-route-tipo="plataformas" class="btn @(Model.Tipo == "plataformas" ? "btn-primary" : "btn-outline-primary")">Plataformas</a>
        <a asp-action="Index" asp-route-tipo="tags" class="btn @(Model.Tipo == "tags" ? "btn-primary" : "btn-outline-primary")">Tags</a>
    </div>
    @if (TempData["Sucesso"] != null) { <div class="alert alert-success">@TempData["Sucesso"]</div> }
    @if (TempData["Erro"] != null) { <div class="alert alert-danger">@TempData["Erro"]</div> }
    <a asp-action="Formulario" asp-route-tipo="@Model.Tipo" class="btn btn-success mb-3">+ Novo cadastro</a>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead><tr><th>ID</th><th>Nome</th>@if(Model.Tipo == "generos") { <th>Descrição</th> }<th>Uso</th><th>Ações</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td>@item.Id</td><td>@item.Nome</td>
                        @if(Model.Tipo == "generos") { <td>@item.Descricao</td> }
                        <td>@(item.EmUso ? "Em uso" : "Livre")</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Formulario" asp-route-tipo="@Model.Tipo" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                                @if (!item.EmUso)
                                {
                                    <form asp-action="Excluir" method="post" onsubmit="return confirm('Excluir este cadastro?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tipo" value="@Model.Tipo" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                                    </form>
                                }
                                else { <span class="text-muted small">Exclusão indisponível</span> }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Itens.Any()) { <div class="alert alert-info">Nenhum cadastro encontrado.</div> }
</div>
