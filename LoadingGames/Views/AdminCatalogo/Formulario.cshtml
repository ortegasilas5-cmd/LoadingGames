@model LoadingGames.Models.AdminCatalogoFormularioViewModel
@{
    ViewData["Title"] = (Model.Id.HasValue ? "Editar " : "Novo cadastro — ") + ViewBag.Titulo;
}
<div class="container mt-4">
    <h1>@(Model.Id.HasValue ? "Editar" : "Cadastrar") — @ViewBag.Titulo</h1>
    <form asp-action="Salvar" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Tipo" type="hidden" />
        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" maxlength="100" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        @if (Model.Tipo == "generos")
        {
            <div class="mb-3">
                <label asp-for="Descricao" class="form-label">Descrição (opcional)</label>
                <textarea asp-for="Descricao" class="form-control" maxlength="255" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>
        }
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" asp-route-tipo="@Model.Tipo" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
