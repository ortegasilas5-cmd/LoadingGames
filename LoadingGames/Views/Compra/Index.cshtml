@model LoadingGames.Models.Carrinho
@{
    ViewData["Title"] = "Finalizar Compra";
    decimal total = Model?.Itens.Sum(i => i.Jogo.Preco) ?? 0;
}
<section class="lg-shop-page container">
    <header class="lg-shop-heading"><span class="lg-shop-kicker">QUASE LÁ</span><h1>Finalizar compra</h1><p>Revise seus jogos e escolha a forma de pagamento.</p></header>
    @if (Model == null || !Model.Itens.Any())
    {
        <div class="lg-shop-empty"><h2>Não há jogos para finalizar</h2><p>Adicione jogos ao carrinho para continuar.</p><a asp-controller="Jogo" asp-action="Index" class="lg-shop-primary">Explorar jogos</a></div>
    }
    else
    {
        <div class="lg-shop-layout"><div class="lg-shop-products"><h2>Seus jogos <span>(@Model.Itens.Count)</span></h2>
            @foreach (var item in Model.Itens)
            {
                <article class="lg-shop-product"><div class="lg-shop-product-image">
                    @if (!string.IsNullOrWhiteSpace(item.Jogo.ImagemPrincipalUrl)) { <img src="@item.Jogo.ImagemPrincipalUrl" alt="Capa de @item.Jogo.Nome" loading="lazy" /> }
                    else { <span>🎮</span> }
                    </div><div class="lg-shop-product-info"><h3>@item.Jogo.Nome</h3><span class="lg-shop-product-label">Jogo digital</span><strong>@item.Jogo.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div></article>
            }
            <a asp-controller="Carrinho" asp-action="Index" class="lg-shop-back">← Voltar ao carrinho</a>
        </div><aside class="lg-shop-summary"><h2>Resumo da compra</h2><div class="lg-shop-summary-row"><span>Jogos</span><span>@Model.Itens.Count</span></div><div class="lg-shop-summary-total"><span>Total</span><strong>@total.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div>
            <form asp-controller="Compra" asp-action="Finalizar" method="post" class="lg-shop-checkout-form">
                @Html.AntiForgeryToken()
                <label for="formaPagamento">Forma de pagamento</label>
                <select id="formaPagamento" name="formaPagamento" required><option value="">Selecione</option><option value="Cartao">Cartão</option><option value="Pix">Pix</option><option value="Boleto">Boleto</option></select>
                <button type="submit" class="lg-shop-primary lg-shop-full">Confirmar compra →</button>
            </form><p class="lg-shop-note">Compra simulada para fins acadêmicos. Não há cobrança real.</p>
        </aside></div>
    }
</section>
