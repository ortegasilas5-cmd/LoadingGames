@model LoadingGames.Models.Compra
@{
    ViewData["Title"] = "Compra Concluída";
}
<section class="lg-shop-page container">
    <div class="lg-shop-success"><div class="lg-shop-success-icon">✓</div><span class="lg-shop-kicker">PEDIDO CONFIRMADO</span><h1>Compra realizada com sucesso!</h1><p>Seus jogos foram adicionados à sua biblioteca.</p>
        <div class="lg-shop-success-details"><div><span>Número da compra</span><strong>#@Model.IdCompra</strong></div><div><span>Data</span><strong>@Model.DataCompra.ToString("dd/MM/yyyy HH:mm")</strong></div><div><span>Forma de pagamento</span><strong>@(Model.FormaPagamento == "Cartao" ? "Cartão" : Model.FormaPagamento)</strong></div><div><span>Status</span><strong>@Model.StatusCompra</strong></div></div>
        <div class="lg-shop-success-items"><h2>Jogos adquiridos</h2>
            @foreach (var item in Model.Itens)
            {
                <div class="lg-shop-success-item"><div class="lg-shop-success-item-name">
                    @if (!string.IsNullOrWhiteSpace(item.Jogo.ImagemPrincipalUrl)) { <img src="@item.Jogo.ImagemPrincipalUrl" alt="Capa de @item.Jogo.Nome" /> }
                    <strong>@item.Jogo.Nome</strong></div><span>@item.PrecoUnitario.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span></div>
            }
            <div class="lg-shop-summary-total"><span>Total</span><strong>@Model.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div>
        </div>
        <div class="lg-shop-success-actions"><a asp-controller="Biblioteca" asp-action="Index" class="lg-shop-primary">Ir para minha biblioteca →</a><a asp-controller="Jogo" asp-action="Index" class="lg-shop-back">Continuar navegando</a></div>
    </div>
</section>
