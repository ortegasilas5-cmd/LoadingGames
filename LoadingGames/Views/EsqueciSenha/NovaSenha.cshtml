@{
    ViewData["Title"] = "Nova senha";
    ViewData["HideNavbar"] = true;
}

<div class="new-password-page">

    <section class="new-password-visual">

        <div class="new-password-visual-overlay"></div>

        <div class="new-password-visual-content">

            <a asp-controller="Home"
               asp-action="Index"
               class="new-password-brand">

                <span class="new-password-brand-text">
                    <strong>
                        Loading <span>Games</span>
                    </strong>

                    <small>
                        SEU MUNDO GAMER
                    </small>
                </span>

            </a>

            <div class="new-password-hero">

                <span class="new-password-hero-label">
                    NOVA SENHA
                </span>

                <h1>
                    RECUPERE<br />
                    <span>SUA CONTA.</span>
                </h1>

                <p>
                    Crie uma nova senha<br />
                    e continue sua jornada.
                </p>

                <div class="new-password-hero-line"></div>

            </div>

        </div>

    </section>

    <section class="new-password-panel">

        <div class="new-password-card">

            <header class="new-password-header">

                <span class="new-password-kicker">
                    SEGURANÇA
                </span>

                <h2>
                    Nova senha
                </h2>

                <p>
                    Digite sua nova senha e confirme para
                    recuperar o acesso à sua conta.
                </p>

            </header>

            <form asp-controller="EsqueciSenha"
                  asp-action="NovaSenha"
                  method="post"
                  class="new-password-form">

                @Html.AntiForgeryToken()

                <div class="new-password-field">

                    <label for="novaSenha">
                        Nova senha
                    </label>

                    <div class="new-password-input-wrapper">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M7 10V8a5 5 0 0 1 10 0v2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="10"
                                  rx="2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.7" />

                            <circle cx="12"
                                    cy="15"
                                    r="1.2"
                                    fill="currentColor" />

                        </svg>

                        <input type="password"
                               id="novaSenha"
                               name="novaSenha"
                               placeholder="Digite sua nova senha"
                               autocomplete="new-password"
                               required />

                    </div>

                </div>

                <div class="new-password-field">

                    <label for="confirmarSenha">
                        Confirmar senha
                    </label>

                    <div class="new-password-input-wrapper">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M7 10V8a5 5 0 0 1 10 0v2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="10"
                                  rx="2"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.7" />

                            <path d="m9 15 2 2 4-4"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />

                        </svg>

                        <input type="password"
                               id="confirmarSenha"
                               name="confirmarSenha"
                               placeholder="Digite novamente sua senha"
                               autocomplete="new-password"
                               required />

                    </div>

                </div>

                @if (ViewBag.Erro != null)
                {
                    <div class="new-password-error">
                        @ViewBag.Erro
                    </div>
                }

                <button type="submit"
                        class="new-password-submit">

                    <span>
                        Alterar senha
                    </span>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M5 12h13M13 6l6 6-6 6"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                    </svg>

                </button>

            </form>

            <div class="new-password-back">

                <a asp-controller="Login"
                   asp-action="Index">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M19 12H5M11 18l-6-6 6-6"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                    </svg>

                    Voltar para o login

                </a>

            </div>

            <div class="new-password-security">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M12 3 5 6v5c0 4.5 2.9 8.3 7 10 4.1-1.7 7-5.5 7-10V6l-7-3Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linejoin="round" />

                    <path d="m9 12 2 2 4-4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round" />

                </svg>

                <span>
                    Seus dados estão protegidos
                </span>

            </div>

        </div>

    </section>

</div>