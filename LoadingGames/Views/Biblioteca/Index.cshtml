@model IEnumerable<LoadingGames.Models.PosseJogo>
@{
    ViewData["Title"] = "Minha Biblioteca";
    var jogos = Model.ToList();
}

<section class="lg-library-page">
    <div class="lg-management-heading">
        <div>
            <span class="lg-eyebrow">SUA COLEÇÃO</span>
            <h1>Minha Biblioteca</h1>
            <p>Todos os seus jogos adquiridos em um só lugar.</p>
        </div>
        <a asp-controller="Jogo" asp-action="Index" class="lg-action-primary">Explorar jogos →</a>
    </div>

    <div class="lg-library-count">
        <span>🎮</span>
        <strong>@jogos.Count</strong>
        <span>@(jogos.Count == 1 ? "jogo na biblioteca" : "jogos na biblioteca")</span>
    </div>

    @if (jogos.Count == 0)
    {
        <div class="lg-empty-state">
            <div class="lg-empty-icon">🎮</div>
            <h2>Sua biblioteca está esperando!</h2>
            <p>Explore o catálogo e descubra sua próxima aventura.</p>
            <a asp-controller="Jogo" asp-action="Index" class="lg-action-primary">Ver catálogo</a>
        </div>
    }
    else
    {
        <div class="lg-library-grid">
            @foreach (var posse in jogos)
            {
                <article class="lg-library-card">
                    <a asp-controller="Jogo" asp-action="Details" asp-route-id="@posse.Jogo.IdJogo"
                       class="lg-library-art" aria-label="Ver detalhes de @posse.Jogo.Nome">
                        @if (!string.IsNullOrWhiteSpace(posse.Jogo.ImagemPrincipalUrl))
                        {
                            <img src="@posse.Jogo.ImagemPrincipalUrl" alt="Capa de @posse.Jogo.Nome" loading="lazy" />
                        }
                        else
                        {
                            <span class="lg-library-no-art">🎮</span>
                        }
                        <span class="lg-library-owned">✓ Na biblioteca</span>
                    </a>
                    <div class="lg-library-content">
                        <h2>@posse.Jogo.Nome</h2>
                        <p>Adquirido em @posse.DataAquisicao.ToString("dd/MM/yyyy")</p>
                        <a asp-controller="Jogo" asp-action="Details" asp-route-id="@posse.Jogo.IdJogo"
                           class="lg-library-detail">Ver detalhes <span aria-hidden="true">→</span></a>
                    </div>
                </article>
            }
        </div>
    }
</section>
