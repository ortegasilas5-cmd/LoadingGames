<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Loading Games
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LoadingGames.styles.css"
          asp-append-version="true" />

</head>

<body>

    @{
        bool hideNavbar =
            ViewData["HideNavbar"] is bool value && value;
    }


    @* =====================================================
       NAVBAR
       Não aparece na tela de Login
       ===================================================== *@

    @if (!hideNavbar)
    {
        <header>

            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

                <div class="container-fluid">

                    <!-- LOGO -->

                    <a class="navbar-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        Loading Games

                    </a>


                    <!-- MENU MOBILE -->

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Abrir menu">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <!-- MENU -->

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Início

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Produto"
                                   asp-action="Index">

                                    Jogos

                                </a>

                            </li>

                        </ul>


                        <!-- USUÁRIO -->

                        <div class="usuario-area">

                            @if (Context.Session.GetString("UsuarioNome") != null)
                            {
                                <div class="usuario-logado">

                                    <div class="usuario-icone">
                                        👤
                                    </div>

                                    <div class="usuario-info">

                                        <span class="usuario-nome">
                                            @Context.Session.GetString("UsuarioNome")
                                        </span>

                                        <span class="usuario-status">
                                            ● Online
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <a asp-controller="Login"
                                   asp-action="Index"
                                   class="btn-login">

                                    Entrar

                                </a>
                            }

                        </div>

                    </div>

                </div>

            </nav>

        </header>
    }


    @* =====================================================
       CONTEÚDO
       Login ocupa a tela inteira.
       As demais páginas continuam dentro do container.
       ===================================================== *@

    @if (hideNavbar)
    {
        @RenderBody()
    }
    else
    {
        <div class="container">

            <main role="main"
                  class="pb-3">

                @RenderBody()

            </main>

        </div>
    }


    @* =====================================================
       RODAPÉ
       Não aparece na tela de Login.
       ===================================================== *@

    @if (!hideNavbar)
    {
        <footer class="border-top footer text-muted">

            <div class="container">

                &copy; 2026 - Loading Games -

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">

                    Privacy

                </a>

            </div>

        </footer>
    }


    @* =====================================================
       SCRIPTS
       ===================================================== *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>