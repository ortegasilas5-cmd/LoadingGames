@model List<LoadingGames.Models.Produto>

@{
    ViewData["Title"] = "Jogos";
}

<div class="text-center">
    <h1 class="display-4">Jogos</h1>

    <p>Bem-vindo à área de jogos da LoadingGames!</p>
</div>

<div class="row">

    @foreach (var produto in Model)
    {
        <div class="card" style="width: 18rem; margin: 20px auto;">

            <img src="~/images/@produto.ImagemUrl"
                 class="card-img-top"
                 alt="Capa do @produto.Nome">

            <div class="card-body">

                <h5 class="card-title">@produto.Nome</h5>

                <p class="card-text">
                    @produto.Descricao
                </p>

                <p>
                    <strong>R$ @produto.Preco.ToString("0.00")</strong>
                </p>

                <a asp-controller="Produto"
                   asp-action="Details"
                   asp-route-id="@produto.IdProduto"
                   class="btn btn-primary">
                    Ver detalhes
                </a>

            </div>

        </div>
    }
</div>