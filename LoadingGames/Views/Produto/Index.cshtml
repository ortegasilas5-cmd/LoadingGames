@{
    ViewData["Title"] = "Jogos";
}

<div class="text-center">
    <h1 class="display-4">Jogos</h1>

    <p>Bem-vindo à área de jogos da LoadingGames!</p>
</div>

<div class="row">

    <!-- Card GTA V -->
    <div class="card" style="width: 18rem; margin: 20px auto;">

        <img src="~/images/capagtav.jpg" class="card-img-top" alt="Capa do GTA V">

        <div class="card-body">
            <h5 class="card-title">GTA V</h5>

            <p class="card-text">
                Grand Theft Auto V para PC.
            </p>

            <p>
                <strong>R$ 99,90</strong>
            </p>

            <a asp-controller="Produto"
               asp-action="Details"
               asp-route-id="1"
               class="btn btn-primary">
                Ver detalhes
            </a>
        </div>

    </div>

    <!-- Card Red Dead Redemption 2 -->
    <div class="card" style="width: 18rem; margin: 20px auto;">

        <img src="~/images/capareddead.jpg" class="card-img-top" alt="Capa do Red Dead Redemption 2">

        <div class="card-body">
            <h5 class="card-title">Red Dead Redemption 2</h5>

            <p class="card-text">
                Red Dead Redemption 2 para PC.
            </p>

            <p>
                <strong>R$ 199,90</strong>
            </p>

            <a asp-controller="Produto"
               asp-action="Details"
               asp-route-id="2"
               class="btn btn-primary">
                Ver detalhes
            </a>
        </div>

    </div>

</div>