
@model LoadingGames.Models.Produto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Novo Jogo";
}

<div class="container mt-4">

    <h1 class="mb-4">Novo Jogo</h1>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do jogo</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Preco" class="form-label">Preço</label>
            <input asp-for="Preco" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CodigoBarras" class="form-label">Código de barras</label>
            <input asp-for="CodigoBarras" class="form-control" />
            <span asp-validation-for="CodigoBarras" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImagemUrl" class="form-label">URL da imagem</label>
            <input asp-for="ImagemUrl" class="form-control" />
            <span asp-validation-for="ImagemUrl" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdCategoria" class="form-label">Categoria</label>

            <select asp-for="IdCategoria"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categorias, "IdCategoria", "Nome"))">
                <option value="">Selecione uma categoria</option>
            </select>

            <span asp-validation-for="IdCategoria" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdFabricante" class="form-label">Fabricante</label>

            <select asp-for="IdFabricante"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Fabricantes, "IdFabricante", "Nome"))">
                <option value="">Selecione um fabricante</option>
            </select>

            <span asp-validation-for="IdFabricante" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label">
                Jogo ativo no catálogo
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
            Cadastrar jogo
        </button>

        <a asp-action="Crud" class="btn btn-secondary">
            Voltar
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

