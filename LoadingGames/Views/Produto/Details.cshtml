@model LoadingGames.Models.Produto

@{
    ViewData["Title"] = "Detalhes do jogo";
}

<div class="text-center">

    <img src="~/images/@Model.ImagemUrl"
         alt="Capa do @Model.Nome"
         style="width: 250px;">

    <h1>@Model.Nome</h1>

    <p>
        @Model.Descricao
    </p>

    <p>
        <strong>Preço:</strong> R$ @Model.Preco.ToString("0.00")
    </p>

    <p>
        <strong>Plataforma:</strong> PC
    </p>

</div>