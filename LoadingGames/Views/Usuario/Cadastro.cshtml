@model LoadingGames.Models.CadastroViewModel

@{
    ViewData["Title"] = "Criar conta";
}

<h1>Criar conta</h1>

<form asp-controller="Usuario" asp-action="Cadastro" method="post">

    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="NomeUsuario"></label>
        <input asp-for="NomeUsuario" />
        <span asp-validation-for="NomeUsuario"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Senha"></label>
        <input asp-for="Senha" />
        <span asp-validation-for="Senha"></span>
    </div>

    <div>
        <label asp-for="ConfirmarSenha"></label>
        <input asp-for="ConfirmarSenha" />
        <span asp-validation-for="ConfirmarSenha"></span>
    </div>

    <button type="submit">Criar conta</button>

</form>

<p>
    Já possui uma conta?
    <a asp-controller="Usuario" asp-action="Login">Entrar</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}