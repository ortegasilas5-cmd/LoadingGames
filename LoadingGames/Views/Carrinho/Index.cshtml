@model LoadingGames.Models.Carrinho
@{
    ViewData["Title"] = "Meu Carrinho";
    decimal total = Model?.Itens.Sum(i => i.Jogo.Preco) ?? 0;
}
<section class="lg-shop-page container">
    <header class="lg-shop-heading"><span class="lg-shop-kicker">SUA PRÓXIMA AVENTURA</span><h1>Meu Carrinho</h1><p>Confira os jogos escolhidos antes de finalizar.</p></header>
    @if (TempData["Sucesso"] != null) { <div class="alert alert-success" role="alert">@TempData["Sucesso"]</div> }
    @if (TempData["Aviso"] != null) { <div class="alert alert-warning" role="alert">@TempData["Aviso"]</div> }
    @if (Model == null || !Model.Itens.Any())
    {
        <div class="lg-shop-empty"><div class="lg-shop-empty-icon">🎮</div><h2>Seu carrinho está vazio</h2><p>Que tal encontrar seu próximo jogo favorito?</p><a asp-controller="Jogo" asp-action="Index" class="lg-shop-primary">Explorar jogos →</a></div>
    }
    else
    {
        <div class="lg-shop-layout">
            <div class="lg-shop-products"><h2>Jogos selecionados <span>(@Model.Itens.Count)</span></h2>
                @foreach (var item in Model.Itens)
                {
                    <article class="lg-shop-product">
                        <a asp-controller="Jogo" asp-action="Details" asp-route-id="@item.Jogo.IdJogo" class="lg-shop-product-image">
                            @if (!string.IsNullOrWhiteSpace(item.Jogo.ImagemPrincipalUrl)) { <img src="@item.Jogo.ImagemPrincipalUrl" alt="Capa de @item.Jogo.Nome" loading="lazy" /> }
                            else { <span>🎮</span> }
                        </a>
                        <div class="lg-shop-product-info"><h3><a asp-controller="Jogo" asp-action="Details" asp-route-id="@item.Jogo.IdJogo">@item.Jogo.Nome</a></h3><span class="lg-shop-product-label">Jogo digital</span><strong>@item.Jogo.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div>
                        <form asp-controller="Carrinho" asp-action="Remover" method="post" class="lg-shop-remove-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idItemCarrinho" value="@item.IdItemCarrinho" />
                            <button type="submit" class="lg-shop-remove">Remover</button>
                        </form>
                    </article>
                }
                <a asp-controller="Jogo" asp-action="Index" class="lg-shop-back">← Continuar comprando</a>
            </div>
            <aside class="lg-shop-summary"><h2>Resumo do pedido</h2><div class="lg-shop-summary-row"><span>Jogos</span><span>@Model.Itens.Count</span></div><div class="lg-shop-summary-total"><span>Total</span><strong>@total.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div><a asp-controller="Compra" asp-action="Index" class="lg-shop-primary lg-shop-full">Finalizar compra →</a><p class="lg-shop-note">Confira os detalhes antes de confirmar.</p></aside>
        </div>
    }
</section>
