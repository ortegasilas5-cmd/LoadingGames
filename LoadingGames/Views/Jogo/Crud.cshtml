@model List<LoadingGames.Models.Jogo>

@{
    ViewData["Title"] = "Gerenciar Jogos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gerenciar Jogos</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Novo jogo
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Sucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>Ativo</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var jogo in Model)
                {
                    <tr>

                        <td>@jogo.IdJogo</td>

                        <td>
                            @if (!string.IsNullOrEmpty(jogo.ImagemPrincipalUrl))
                            {
                                <img src="@jogo.ImagemPrincipalUrl"
                                     alt="@jogo.Nome"
                                     style="width: 80px; height: 50px; object-fit: cover;" />
                            }
                        </td>

                        <td>@jogo.Nome</td>

                        <td>
                            R$ @jogo.Preco.ToString("N2")
                        </td>

                        <td>
                            @if (jogo.Ativo)
                            {
                                <span class="badge bg-success">
                                    Ativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inativo
                                </span>
                            }
                        </td>

                        <td>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Edit"
                                   asp-route-id="@jogo.IdJogo"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <form asp-controller="Jogo"
                                      asp-action="AlterarStatus"
                                      method="post"
                                      onsubmit="return confirm('@(jogo.Ativo ? "Deseja desativar este jogo?" : "Deseja reativar este jogo?")');">

                                    <input type="hidden"
                                           name="id"
                                           value="@jogo.IdJogo" />

                                    @if (jogo.Ativo)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Desativar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Reativar
                                        </button>
                                    }

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
