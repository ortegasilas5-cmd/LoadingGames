@model LoadingGames.Models.Jogo

@{
    ViewData["Title"] = Model.Nome;
}

<div class="detalhes-jogo">

    <!-- CAPA DO JOGO -->
    <div class="detalhes-capa">

        <img src="@Model.ImagemPrincipalUrl"
             alt="Capa do @Model.Nome">

    </div>

    <!-- INFORMAÇÕES DO JOGO -->
    <div class="detalhes-conteudo">

        <span class="detalhes-tag">
            JOGO
        </span>

        <h1>@Model.Nome</h1>

        <!-- DESCRIÇÃO -->
        <p class="detalhes-descricao">
            @Model.Descricao
        </p>

        <!-- GÊNEROS -->
        <div class="detalhes-generos">

            @if (Model.Generos.Any())
            {
                foreach (var genero in Model.Generos)
                {
                    <span class="genero-tag">
                        @genero.Nome
                    </span>
                }
            }
            else
            {
                <span class="genero-tag">
                    Não informado
                </span>
            }

        </div>

        <!-- PREÇO -->
        <div class="detalhes-compra">

            <div class="detalhes-preco">
                @Model.Preco.ToString(
                    "C",
                    new System.Globalization.CultureInfo("pt-BR")
                )
            </div>

            <button class="detalhes-botao">
                Comprar
            </button>

        </div>

        <!-- INFORMAÇÕES -->
        <div class="detalhes-informacoes">

            <div class="informacao-item">
                <span>Desenvolvedor</span>
                <strong>@Model.Desenvolvedor.Nome</strong>
            </div>

            <div class="informacao-item">
                <span>Publicadora</span>
                <strong>@Model.Publicadora.Nome</strong>
            </div>

            @if (Model.DataLancamento.HasValue)
            {
                <div class="informacao-item">
                    <span>Data de lançamento</span>
                    <strong>
                        @Model.DataLancamento.Value.ToString("dd/MM/yyyy")
                    </strong>
                </div>
            }

            <div class="informacao-item">
                <span>Classificação indicativa</span>
                <strong>
                    @Model.ClassificacaoIndicativa anos
                </strong>
            </div>

            <div class="informacao-item">
                <span>Plataforma</span>
                <strong>PC</strong>
            </div>

        </div>

        <!-- VOLTAR -->
        <a asp-controller="Jogo"
           asp-action="Index"
           class="detalhes-voltar">
            ← Voltar ao catálogo
        </a>

    </div>

</div>