<div class="container">

    <h2 class="mb-4">
        Avaliações
    </h2>

    <!-- MENSAGENS -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Aviso"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Aviso"]
        </div>
    }

    @if (usuarioLogado && possuiJogo && avaliacaoUsuario == null)
    {
        <!-- CRIAR AVALIAÇÃO -->

        <div class="card mb-4">

            <div class="card-body">

                <h4 class="card-title">
                    Avalie este jogo
                </h4>

                <p class="text-muted">
                    Você possui este jogo. Conte o que achou dele.
                </p>

                <form asp-controller="Avaliacao"
                      asp-action="Criar"
                      method="post">

                    <input type="hidden"
                           name="idJogo"
                           value="@Model.IdJogo" />

                    <div class="mb-3">

                        <label class="form-label">
                            Sua avaliação
                        </label>

                        <div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="avaliacaoPositiva"
                                       value="Positiva"
                                       required />

                                <label class="form-check-label"
                                       for="avaliacaoPositiva">
                                    👍 Recomendo
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="avaliacaoNegativa"
                                       value="Negativa"
                                       required />

                                <label class="form-check-label"
                                       for="avaliacaoNegativa">
                                    👎 Não recomendo
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="comentario"
                               class="form-label">
                            Comentário
                        </label>

                        <textarea id="comentario"
                                  name="comentario"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Conte o que você achou do jogo..."></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Publicar avaliação
                    </button>

                </form>

            </div>

        </div>
    }
    else if (usuarioLogado && possuiJogo && avaliacaoUsuario != null)
    {
        <!-- EDITAR AVALIAÇÃO -->

        <div class="card mb-4">

            <div class="card-body">

                <h4 class="card-title">
                    Sua avaliação
                </h4>

                <p class="text-muted">
                    Você já avaliou este jogo. Você pode alterar ou excluir sua avaliação.
                </p>

                <form asp-controller="Avaliacao"
                      asp-action="Editar"
                      method="post">

                    <input type="hidden"
                           name="idAvaliacao"
                           value="@avaliacaoUsuario.IdAvaliacao" />

                    <div class="mb-3">

                        <label class="form-label">
                            Sua avaliação
                        </label>

                        <div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="editarPositiva"
                                       value="Positiva"
                                       checked="@(avaliacaoUsuario.Tipo == "Positiva")"
                                       required />

                                <label class="form-check-label"
                                       for="editarPositiva">
                                    👍 Recomendo
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="editarNegativa"
                                       value="Negativa"
                                       checked="@(avaliacaoUsuario.Tipo == "Negativa")"
                                       required />

                                <label class="form-check-label"
                                       for="editarNegativa">
                                    👎 Não recomendo
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="editarComentario"
                               class="form-label">
                            Comentário
                        </label>

                        <textarea id="editarComentario"
                                  name="comentario"
                                  class="form-control"
                                  rows="4">@avaliacaoUsuario.Comentario</textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Salvar alterações
                    </button>

                </form>

                <!-- EXCLUIR AVALIAÇÃO -->
                <form asp-controller="Avaliacao"
                      asp-action="Excluir"
                      method="post"
                      class="mt-2"
                      onsubmit="return confirm('Tem certeza que deseja excluir sua avaliação?');">

                    <input type="hidden"
                           name="idAvaliacao"
                           value="@avaliacaoUsuario.IdAvaliacao" />

                    <button type="submit"
                            class="btn btn-danger">
                        Excluir avaliação
                    </button>

                </form>

            </div>

        </div>
    }
    else if (usuarioLogado && !possuiJogo)
    {
        <div class="alert alert-secondary">
            Você precisa possuir este jogo para avaliá-lo.
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Entre na sua conta e adquira o jogo para poder avaliá-lo.
        </div>
    }

    <!-- LISTA DE AVALIAÇÕES -->

