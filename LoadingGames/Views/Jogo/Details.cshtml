@model LoadingGames.Models.Jogo
@using LoadingGames.Models
@using System.Globalization
@{
    ViewData["Title"] = Model.Nome;
    var avaliacoes = ViewBag.Avaliacoes as List<Avaliacao> ?? new List<Avaliacao>();
    bool possuiJogo = ViewBag.PossuiJogo is bool valor && valor;
    Avaliacao? avaliacaoUsuario = ViewBag.AvaliacaoUsuario as Avaliacao;
    bool usuarioLogado = Context.Session.GetInt32("UsuarioId") != null;
    var preco = Model.Preco.ToString("C", new CultureInfo("pt-BR"));
}

<div class="lg-game-details">
    <a class="lg-back-link" asp-controller="Jogo" asp-action="Index">← Voltar ao catálogo</a>
    <div class="lg-game-heading">
        <div><span class="lg-eyebrow">EXPLORE UM NOVO UNIVERSO</span><h1>@Model.Nome</h1></div>
        <span class="lg-game-pill">JOGO DIGITAL</span>
    </div>
    <div class="lg-game-columns">
        <div class="lg-game-media">
            <div class="lg-main-art"><img src="@Model.ImagemPrincipalUrl" alt="Capa de @Model.Nome" /></div>
            @if (Model.Imagens.Any())
            {
                <section class="lg-gallery" aria-label="Capturas de tela">
                    <h2>Capturas de tela</h2>
                    <div class="lg-gallery-grid">
                        @foreach (var imagem in Model.Imagens.OrderBy(i => i.IdImagem))
                        {
                            <a href="@imagem.UrlImagem" target="_blank" rel="noopener noreferrer"><img src="@imagem.UrlImagem" loading="lazy" alt="Captura de tela de @Model.Nome" /></a>
                        }
                    </div>
                </section>
            }
        </div>
        <div class="lg-game-side">
            <div class="lg-game-panel">
                <span class="lg-eyebrow">SOBRE O JOGO</span>
                <p class="lg-game-description">@Model.Descricao</p>
                @if (Model.Generos.Any()) { <div class="lg-game-tags">@foreach (var g in Model.Generos.OrderBy(g => g.Nome)) { <span>@g.Nome</span> }</div> }
                @if (Model.Tags.Any()) { <div class="lg-game-tags lg-tags-secondary">@foreach (var t in Model.Tags.OrderBy(t => t.Nome)) { <span>@t.Nome</span> }</div> }
                <div class="lg-game-buy">
                    <span>PREÇO</span>
                    <strong>@preco</strong>
                    @if (possuiJogo)
                    {
                        <a class="lg-buy-button" asp-controller="Biblioteca" asp-action="Index">✓ Na sua biblioteca</a>
                    }
                    else if (Model.Ativo)
                    {
                        <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idJogo" value="@Model.IdJogo" />
                            <button class="lg-buy-button" type="submit">🛒 Adicionar ao carrinho</button>
                        </form>
                    }
                    else
                    {
                        <div class="lg-unavailable">Jogo indisponível para compra</div>
                    }
                </div>
            </div>
            <div class="lg-game-panel lg-game-specs">
                <h2>Informações do jogo</h2>
                <div><span>Desenvolvedora</span><strong>@(Model.Desenvolvedor?.Nome ?? "Não informada")</strong></div>
                <div><span>Publicadora</span><strong>@(Model.Publicadora?.Nome ?? "Não informada")</strong></div>
                @if (Model.DataLancamento.HasValue) { <div><span>Lançamento</span><strong>@Model.DataLancamento.Value.ToString("dd/MM/yyyy")</strong></div> }
                <div><span>Classificação</span><strong>@Model.ClassificacaoIndicativa anos</strong></div>
                <div><span>Plataformas</span><strong>@(Model.Plataformas.Any() ? string.Join(", ", Model.Plataformas.OrderBy(p => p.Nome).Select(p => p.Nome)) : "Não informadas")</strong></div>
            </div>
        </div>
    </div>
</div>

<hr class="my-5 lg-section-divider" />

<div class="container lg-reviews">

    <h2 class="mb-4">
        Avaliações
    </h2>

    <!-- MENSAGENS -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Aviso"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Aviso"]
        </div>
    }

    @if (usuarioLogado && possuiJogo && avaliacaoUsuario == null)
    {
        <!-- CRIAR AVALIAÇÃO -->

        <div class="card mb-4">

            <div class="card-body">

                <h4 class="card-title">
                    Avalie este jogo
                </h4>

                <p class="text-muted">
                    Você possui este jogo. Conte o que achou dele.
                </p>

                <form asp-controller="Avaliacao"
                      asp-action="Criar"
                      method="post">

                    <input type="hidden"
                           name="idJogo"
                           value="@Model.IdJogo" />

                    <div class="mb-3">

                        <label class="form-label">
                            Sua avaliação
                        </label>

                        <div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="avaliacaoPositiva"
                                       value="Positiva"
                                       required />

                                <label class="form-check-label"
                                       for="avaliacaoPositiva">
                                    👍 Recomendo
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="avaliacaoNegativa"
                                       value="Negativa"
                                       required />

                                <label class="form-check-label"
                                       for="avaliacaoNegativa">
                                    👎 Não recomendo
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="comentario"
                               class="form-label">
                            Comentário
                        </label>

                        <textarea id="comentario"
                                  name="comentario"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Conte o que você achou do jogo..."></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Publicar avaliação
                    </button>

                </form>

            </div>

        </div>
    }
    else if (usuarioLogado && possuiJogo && avaliacaoUsuario != null)
    {
        <!-- EDITAR AVALIAÇÃO -->

        <div class="card mb-4">

            <div class="card-body">

                <h4 class="card-title">
                    Sua avaliação
                </h4>

                <p class="text-muted">
                    Você já avaliou este jogo. Você pode alterar ou excluir sua avaliação.
                </p>

                <form asp-controller="Avaliacao"
                      asp-action="Editar"
                      method="post">

                    <input type="hidden"
                           name="idAvaliacao"
                           value="@avaliacaoUsuario.IdAvaliacao" />

                    <div class="mb-3">

                        <label class="form-label">
                            Sua avaliação
                        </label>

                        <div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="editarPositiva"
                                       value="Positiva"
                                       checked="@(avaliacaoUsuario.Tipo == "Positiva")"
                                       required />

                                <label class="form-check-label"
                                       for="editarPositiva">
                                    👍 Recomendo
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       name="tipo"
                                       id="editarNegativa"
                                       value="Negativa"
                                       checked="@(avaliacaoUsuario.Tipo == "Negativa")"
                                       required />

                                <label class="form-check-label"
                                       for="editarNegativa">
                                    👎 Não recomendo
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="editarComentario"
                               class="form-label">
                            Comentário
                        </label>

                        <textarea id="editarComentario"
                                  name="comentario"
                                  class="form-control"
                                  rows="4">@avaliacaoUsuario.Comentario</textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Salvar alterações
                    </button>

                </form>

                <!-- EXCLUIR AVALIAÇÃO -->
                <form asp-controller="Avaliacao"
                      asp-action="Excluir"
                      method="post"
                      class="mt-2"
                      onsubmit="return confirm('Tem certeza que deseja excluir sua avaliação?');">

                    <input type="hidden"
                           name="idAvaliacao"
                           value="@avaliacaoUsuario.IdAvaliacao" />

                    <button type="submit"
                            class="btn btn-danger">
                        Excluir avaliação
                    </button>

                </form>

            </div>

        </div>
    }
    else if (usuarioLogado && !possuiJogo)
    {
        <div class="alert alert-secondary">
            Você precisa possuir este jogo para avaliá-lo.
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Entre na sua conta e adquira o jogo para poder avaliá-lo.
        </div>
    }

    <!-- LISTA DE AVALIAÇÕES -->

    <h4 class="mt-5 mb-3">
        Avaliações dos usuários
    </h4>

    @if (!avaliacoes.Any())
    {
        <div class="alert alert-light border">
            Este jogo ainda não possui avaliações.
        </div>
    }
    else
    {
        @foreach (var avaliacao in avaliacoes)
        {
            <div class="card mb-3">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <strong>
                            @avaliacao.Usuario.Nome
                        </strong>

                        <small class="text-muted">

                            @avaliacao.DataAvaliacao.ToString(
                                "dd/MM/yyyy HH:mm"
                            )

                            @if (avaliacao.DataAtualizacao.HasValue)
                            {
                                <span>
                                    — editado em
                                    @avaliacao.DataAtualizacao.Value.ToString(
                                        "dd/MM/yyyy HH:mm"
                                    )
                                </span>
                            }

                        </small>

                    </div>

                    @if (avaliacao.Tipo == "Positiva")
                    {
                        <p class="text-success fw-bold">
                            👍 Recomenda
                        </p>
                    }
                    else
                    {
                        <p class="text-danger fw-bold">
                            👎 Não recomenda
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(avaliacao.Comentario))
                    {
                        <p class="mb-0">
                            @avaliacao.Comentario
                        </p>
                    }

                </div>

            </div>
        }
    }

</div>