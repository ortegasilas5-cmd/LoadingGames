@model LoadingGames.Models.Jogo
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Novo Jogo";
}

<div class="container mt-4">

    <h1 class="mb-4">Novo Jogo</h1>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do jogo</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Descricao"
                      class="form-control"
                      rows="4"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Preco" class="form-label">Preço</label>
            <input asp-for="Preco"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImagemPrincipalUrl" class="form-label">
                URL da imagem principal
            </label>
            <input asp-for="ImagemPrincipalUrl"
                   class="form-control" />
            <span asp-validation-for="ImagemPrincipalUrl"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DataLancamento" class="form-label">
                Data de lançamento
            </label>
            <input asp-for="DataLancamento"
                   class="form-control"
                   type="date" />
            <span asp-validation-for="DataLancamento"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ClassificacaoIndicativa" class="form-label">
                Classificação indicativa
            </label>
            <input asp-for="ClassificacaoIndicativa"
                   class="form-control"
                   type="number"
                   min="0"
                   max="18" />
            <span asp-validation-for="ClassificacaoIndicativa"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdDesenvolvedor" class="form-label">
                Desenvolvedor
            </label>

            <select asp-for="IdDesenvolvedor"
                    class="form-select"
                    asp-items="@(new SelectList(
                                            ViewBag.Desenvolvedores,
                                            "IdDesenvolvedor",
                                            "Nome"))">

                <option value="">Selecione um desenvolvedor</option>

            </select>

            <span asp-validation-for="IdDesenvolvedor"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdPublicadora" class="form-label">
                Publicadora
            </label>

            <select asp-for="IdPublicadora"
                    class="form-select"
                    asp-items="@(new SelectList(
                                            ViewBag.Publicadoras,
                                            "IdPublicadora",
                                            "Nome"))">

                <option value="">Selecione uma publicadora</option>

            </select>

            <span asp-validation-for="IdPublicadora"
                  class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="Ativo"
                   class="form-check-input" />

            <label asp-for="Ativo"
                   class="form-check-label">
                Jogo ativo no catálogo
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
            Cadastrar jogo
        </button>

        <a asp-action="Crud" class="btn btn-secondary">
            Voltar
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}